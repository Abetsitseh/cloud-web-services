# Jeton d'API Fly.io (obligatoire côté serveur pour communiquer avec l'API Fly.io)
# Obtenez-le avec : fly auth token
FLY_TOKEN=

# Clé d'accès administrateur (obligatoire si le serveur écoute sur le réseau, min. 32 caractères)
# En accès local exclusif (127.0.0.1), cette clé peut être omise.
DEPLOY_ACCESS_TOKEN=

# Port d'écoute du serveur HTTP (optionnel, 8080 par défaut)
PORT=8080

# Adresse d'écoute du serveur HTTP (optionnel, 127.0.0.1 par défaut)
HOST=127.0.0.1
